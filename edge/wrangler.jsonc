{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fyde",
  "account_id": "722e88ddf776f83cd48df13e0cf318f9",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  // fyde.izbirakin.com is attached to the "fyde" Worker in Cloudflare Dashboard.
  // Keeping custom domain attachment separate allows deployment without zone/route scopes.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fyde-db",
      "database_id": "14bb0056-41bc-4371-8b64-c2021654b718",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "fyde-blobs"
    }
  ],
  // Workers AI: @cf/google/embeddinggemma-2 multimodal embeddings for photo/video/document search.
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_HUB",
        "class_name": "UserRelayHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRelayHub"]
    }
  ],
  "vars": {
    "PUBLIC_APP_URL": "https://fyde.izbirakin.com",
    "EMAIL_FROM": "fyde. <hello@izbirakin.com>",
    "REQUIRE_INVITE_CODE": "false"
  }
}
